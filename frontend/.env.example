# Copiá este archivo como .env.local y completá los valores

# URL del Worker/API (en desarrollo usa el proxy de Vite, en producción tu dominio/API)
VITE_API_URL=

# Ejemplos:
# Desarrollo local:  dejar vacío (el proxy de vite.config.ts lo maneja)
# Producción:        configurar solo si la API no queda bajo el mismo origen/rewrite
#                    VITE_API_URL=https://api.melinadiazfotografia.com.ar
